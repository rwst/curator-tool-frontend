      </instance>
      <instance DB_ID="9941991" displayName="enzyme-substrate adaptor activity of LALBA [Golgi lumen] Crystal structure of lactose synthase reveals a large conformational change in its catalytic component, the beta1,4-galactosyltransferase-I" isShell="false" isDirty="false" isStructureUpdated="false">
